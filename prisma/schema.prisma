generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AiProvider {
  OPENROUTER
}

enum ShareVisibility {
  PRIVATE
  PUBLIC
  SELECTED
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
  WEB
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  settings      UserSettings?
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         FinancialGoal[]
  aiMemories    AiMemory[]
  aiInsights    AiInsight[]
  shareProfile  ShareProfile?
  channels      ChannelLink[]
  whatsappSession WhatsAppSession?
  trustedDevices TrustedDevice[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserSettings {
  id                   String     @id @default(cuid())
  userId               String     @unique @map("user_id")
  aiProvider           AiProvider @default(OPENROUTER) @map("ai_provider")
  aiModel              String     @default("openai/gpt-4o-mini") @map("ai_model")
  encryptedApiKey      String?    @map("encrypted_api_key") @db.Text
  currency             String     @default("IDR")
  timezone             String     @default("Asia/Jakarta")
  locale               String     @default("id-ID")
  monthlyIncomeHint    Decimal?   @map("monthly_income_hint") @db.Decimal(18, 2)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Category {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  icon      String   @default("circle")
  color     String   @default("#0F766E")
  type      TransactionType @default(EXPENSE)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  type            TransactionType
  amount          Decimal         @db.Decimal(18, 2)
  categoryId      String?         @map("category_id")
  subCategory     String?         @map("sub_category")
  description     String
  paymentMethod   String?         @map("payment_method")
  transactionDate DateTime        @map("transaction_date") @db.Date
  channel         ChannelType     @default(WEB)
  rawInput        String?         @map("raw_input") @db.Text
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Budget {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  categoryId   String   @map("category_id")
  monthlyLimit Decimal  @map("monthly_limit") @db.Decimal(18, 2)
  month        Int
  year         Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@map("budgets")
}

model FinancialGoal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  goalName      String    @map("goal_name")
  targetAmount  Decimal   @map("target_amount") @db.Decimal(18, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(18, 2)
  deadline      DateTime?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("financial_goals")
}

/// Non-financial preference / habit memory only — never store balances or raw transactions here.
model AiMemory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  key       String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("ai_memories")
}

model AiInsight {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String   @db.Text
  severity  String   @default("info")
  periodKey String   @map("period_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodKey])
  @@map("ai_insights")
}

model ShareProfile {
  id          String          @id @default(cuid())
  userId      String          @unique @map("user_id")
  token       String          @unique @default(cuid())
  visibility  ShareVisibility @default(PRIVATE)
  showBalance Boolean         @default(false) @map("show_balance")
  showIncome  Boolean         @default(true) @map("show_income")
  showExpense Boolean         @default(true) @map("show_expense")
  showCharts  Boolean         @default(true) @map("show_charts")
  showGoals   Boolean         @default(false) @map("show_goals")
  displayName String?         @map("display_name")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("share_profiles")
}

model ChannelLink {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  channel    ChannelType
  externalId String      @map("external_id")
  displayName String?    @map("display_name")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId])
  @@map("channel_links")
}

model WhatsAppSession {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  sessionData  String?  @map("session_data") @db.Text
  phoneNumber  String?  @map("phone_number")
  isConnected  Boolean  @default(false) @map("is_connected")
  lastQr       String?  @map("last_qr") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

/// Known browsers/devices for login risk scoring (fingerprint + last geo)
model TrustedDevice {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  fingerprintId String   @map("fingerprint_id")
  userAgent     String?  @map("user_agent") @db.Text
  lastIp        String?  @map("last_ip")
  lastCountry   String?  @map("last_country")
  lastCity      String?  @map("last_city")
  label         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintId])
  @@index([userId])
  @@map("trusted_devices")
}

/// Single-tenant owner/bot config (satu instance = satu pemilik)
model AppConfig {
  id                   String   @id @default("singleton")
  ownerUserId          String?  @unique @map("owner_user_id")
  ownerName            String?  @map("owner_name")
  telegramBotToken     String?  @map("telegram_bot_token") @db.Text
  telegramOwnerChatId  String?  @map("telegram_owner_chat_id")
  whatsappOwnerPhone   String?  @map("whatsapp_owner_phone")
  setupCompleted       Boolean  @default(false) @map("setup_completed")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}
