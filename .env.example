# ═══════════════════════════════════════════════════════════
# Ledgerly — VPS / Docker
# ═══════════════════════════════════════════════════════════
# Alur:
#   cp .env.example .env
#   # (opsional) isi TELEGRAM_BOT_TOKEN / APP_DOMAIN di bawah
#   ./deploy.sh
#
# ./deploy.sh otomatis:
#   - install Docker jika perlu
#   - generate AUTH_SECRET / ENCRYPTION_KEY / passwords
#   - pilih port host yang belum dipakai
#   - set DATABASE_URL + REDIS_URL ke jaringan Docker internal
# ═══════════════════════════════════════════════════════════

# Kosongkan (= auto). Atau paksa: APP_PORT=7341
APP_PORT="auto"

POSTGRES_USER="ledgerly"
POSTGRES_PASSWORD="ledgerly_secret_change_me"
POSTGRES_DB="ledgerly"

# Diisi ulang otomatis oleh ./deploy.sh (jangan pakai Neon di VPS Docker)
DATABASE_URL="postgresql://ledgerly:ledgerly_secret_change_me@postgres:5432/ledgerly"
REDIS_URL="redis://redis:6379"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Diisi otomatis dari IP:port atau APP_DOMAIN=... ./deploy.sh
AUTH_URL="http://127.0.0.1:3047"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3047"

ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Opsional — boleh diisi di /setup setelah web hidup
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
TELEGRAM_BOT_TOKEN=""

WHATSAPP_WORKER_SECRET="change-me-shared-secret"
WHATSAPP_AUTH_DIR="/data/wa-auth"
WHATSAPP_OWNER_USER_ID=""

HOSTNAME="0.0.0.0"
TELEGRAM_EMBEDDED="0"
SECURITY_LOG_DIR="./logs"
LOG_LEVEL="info"
