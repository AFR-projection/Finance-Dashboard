# ═══════════════════════════════════════════════════════════
# Ledgerly — Production (.env di VPS)
# ═══════════════════════════════════════════════════════════
# Wajib: DATABASE_URL = Neon connection string (1 baris utuh)
# Redis internal Docker diisi otomatis oleh install.sh
#
#   cp .env.example .env && nano .env
#   ./install.sh
# ═══════════════════════════════════════════════════════════

# --- WAJIB: Neon PostgreSQL (bukan Postgres Docker) ---
# Console: https://console.neon.tech → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Port host app (auto = script pilih yang kosong). Atau paksa: 7341
APP_PORT="auto"

# Domain publik (untuk Nginx + Let's Encrypt). Kosongkan jika belum punya.
APP_DOMAIN=""

# Diisi otomatis oleh install.sh: 127.0.0.1 kalau ada domain (aman, hanya Nginx),
# 0.0.0.0 kalau belum ada domain (supaya bisa diakses via http://IP:PORT).
APP_BIND="127.0.0.1"

# Diisi otomatis oleh install.sh / deploy.sh
AUTH_URL="http://127.0.0.1:3047"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3047"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
WORKER_SECRET="change-me-shared-secret"

# Redis internal (jangan ubah di Docker)
REDIS_URL="redis://redis:6379"

# Opsional — boleh diisi di /setup UI setelah live
OPENROUTER_API_KEY=""

# Opsional — model cadangan kalau model utama gagal (pisahkan dengan koma)
OPENROUTER_FALLBACK_MODELS=""

TELEGRAM_BOT_TOKEN=""

HOSTNAME="0.0.0.0"
TELEGRAM_EMBEDDED="0"
SECURITY_LOG_DIR="./logs"
LOG_LEVEL="info"
