# ═══════════════════════════════════════════════════════════
# Ledgerly — Environment (Docker di VPS shared)
# ═══════════════════════════════════════════════════════════
# Hanya APP_PORT yang dibuka ke host (default 3001).
# Postgres & Redis INTERNAL — tidak bentrok project lain.

# Host port (hindari: 22, 80, 443, 3000, 8080, 8081)
APP_PORT="3001"

POSTGRES_USER="ledgerly"
POSTGRES_PASSWORD="ledgerly_secret_change_me"
POSTGRES_DB="ledgerly"

# Diisi otomatis oleh ./deploy.sh untuk jaringan Docker internal:
DATABASE_URL="postgresql://ledgerly:ledgerly_secret_change_me@postgres:5432/ledgerly"
REDIS_URL="redis://redis:6379"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3001"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

WHATSAPP_WORKER_SECRET="change-me-shared-secret"
WHATSAPP_AUTH_DIR="/data/wa-auth"
WHATSAPP_OWNER_USER_ID=""

HOSTNAME="0.0.0.0"
LOGIN_SESSION_TTL_SECONDS="300"
LOGIN_GEO_THRESHOLD_KM="500"
SECURITY_LOG_DIR="./logs"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="60"
LOG_LEVEL="info"
